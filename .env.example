# ====================================================================
# AZRAQ E-COMMERCE PLATFORM — ENVIRONMENT CONFIGURATION
# Production Deployment & Paymently Real Payment Gateway
# ====================================================================

# Port for local dev / standalone API server
PORT=3000
NODE_ENV=production

# Production Storefront / Public Application URL (Used for Paymently redirects & callbacks)
# Production Domain: https://azraq.azraqtrips.com
APP_BASE_URL=https://azraq.azraqtrips.com

# --------------------------------------------------------------------
# 1. SECURITY & ADMINISTRATIVE ACCESS (FAIL-CLOSED IN PRODUCTION)
# --------------------------------------------------------------------
# Required: Secret token for accessing admin operations, orders export,
# status updates, and refunds. Minimum 8 characters.
# In production, endpoints reject all requests with HTTP 500 if unconfigured.
ADMIN_API_KEY=replace_with_strong_random_secret_min_16_chars

# --------------------------------------------------------------------
# 2. DURABLE DATABASE PERSISTENCE (FAIL-CLOSED IN PRODUCTION)
# --------------------------------------------------------------------
# Required: PostgreSQL connection string (Neon, Supabase, AWS RDS, Render).
# In production, order creation and webhook processing fail closed if unconfigured,
# preventing data loss from ephemeral serverless memory containers.
DATABASE_URL=postgresql://user:password@host:5432/azraq_store?sslmode=require

# --------------------------------------------------------------------
# 3. PAYMENTLY REAL PAYMENT GATEWAY (BDT - BANGLADESH MARKET)
# --------------------------------------------------------------------
# Official Merchant Domain: azraq.paymently.io
PAYMENTLY_BASE_URL=https://azraq.paymently.io
PAYMENTLY_API_KEY=YOUR_PAYMENTLY_MERCHANT_API_KEY
PAYMENTLY_DEFAULT_PAYMENT_URL=https://azraq.paymently.io/paymentlink/default/BDT
PAYMENTLY_WEBHOOK_SECRET=YOUR_PROVIDER_WEBHOOK_SECRET_IF_SUPPORTED
PAYMENTLY_CURRENCY=BDT

# --------------------------------------------------------------------
# 4. AI VISUAL SEARCH CONFIGURATION
# --------------------------------------------------------------------
VISUAL_AI_PROVIDER=embedded
CLIP_MODEL_NAME=clip-vit-base-patch32
EMBEDDING_DIMENSIONS=128

# Rate Limiting & Upload Guard
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# --------------------------------------------------------------------
# 5. GOOGLE IDENTITY SERVICES (GIS) AUTHENTICATION
# --------------------------------------------------------------------
# Official Google Web Application OAuth Client ID
# Public identifier configured in Google Cloud Console Credentials.
# Frontend and Backend both utilize this identical Client ID.
VITE_GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID
GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
