# ====================================================================
# AZRAQ E-COMMERCE PLATFORM — ENVIRONMENT CONFIGURATION
# ====================================================================

# Port for local dev / standalone API server
PORT=3000

# Next.js / Storefront Public URL (Used for payment redirects & callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Paymently Payment Gateway (BDT - Bangladeshi Taka)
# Official Merchant Account: AZRAQ
PAYMENTLY_BASE_URL=https://vartualtutor.paymently.io
PAYMENTLY_API_KEY=
PAYMENTLY_DEFAULT_PAYMENT_URL=https://vartualtutor.paymently.io/paymentlink/default/BDT
PAYMENTLY_WEBHOOK_SECRET=
PAYMENTLY_CURRENCY=BDT

# AI Visual Search Configuration
# Options: 'embedded' (built-in normalized CLIP vector matcher) | 'openai-clip' | 'huggingface' | 'replicate'
VISUAL_AI_PROVIDER=embedded
CLIP_MODEL_NAME=clip-vit-base-patch32
EMBEDDING_DIMENSIONS=128

# Optional Cloud Visual AI API Keys (when using external providers)
CLIP_API_KEY=
HUGGINGFACE_API_KEY=
OPENAI_API_KEY=

# PostgreSQL Database with pgvector Extension (Optional for standalone backend)
DATABASE_URL=postgresql://postgres:password@localhost:5432/azraq_store
PGVECTOR_TABLE=product_visual_embeddings

# Rate Limiting & Upload Guard
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

