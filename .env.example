# ====================================================================
# AZRAQ E-COMMERCE PLATFORM — ENVIRONMENT CONFIGURATION
# Production Deployment & Paymently Real Payment Gateway
# ====================================================================

# Port for local dev / standalone API server
PORT=3000

# Production Storefront / Public Application URL (Used for Paymently redirects & callbacks)
# Example: https://azraqshop.vercel.app or https://shop.azraqtrips.com
APP_BASE_URL=https://azraqshop.vercel.app
NEXT_PUBLIC_SITE_URL=https://azraqshop.vercel.app

# Paymently Payment Gateway (BDT - Bangladeshi Taka)
# Official Merchant Domain: azraq.paymently.io
PAYMENTLY_BASE_URL=https://azraq.paymently.io
PAYMENTLY_API_KEY=YOUR_PRIVATE_MERCHANT_API_KEY
PAYMENTLY_DEFAULT_PAYMENT_URL=https://azraq.paymently.io/paymentlink/default/BDT
PAYMENTLY_WEBHOOK_SECRET=YOUR_PROVIDER_WEBHOOK_SECRET_IF_SUPPORTED
PAYMENTLY_CURRENCY=BDT

# PostgreSQL Database with pgvector Extension (e.g. Neon, Supabase, AWS RDS, Render)
# Required for atomic order creation, persistent checkout attempts and webhook audit logs
DATABASE_URL=postgresql://user:password@host:5432/azraq_store?sslmode=require

# Administrator Authorization Key for Protected Endpoints
ADMIN_API_KEY=azraq_admin_secret_key_production

# AI Visual Search Configuration
VISUAL_AI_PROVIDER=embedded
CLIP_MODEL_NAME=clip-vit-base-patch32
EMBEDDING_DIMENSIONS=128

# Rate Limiting & Upload Guard
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
