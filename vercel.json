{
  "version": 2,
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/admin/auth",
      "destination": "/api/admin/auth"
    },
    {
      "source": "/api/orders/track",
      "destination": "/api/orders/track"
    },
    {
      "source": "/api/orders/update-status",
      "destination": "/api/orders/update-status"
    },
    {
      "source": "/api/orders",
      "destination": "/api/orders/index"
    },
    {
      "source": "/api/payments/create",
      "destination": "/api/payments/create"
    },
    {
      "source": "/api/payments/verify",
      "destination": "/api/payments/verify"
    },
    {
      "source": "/api/payments/status",
      "destination": "/api/payments/status"
    },
    {
      "source": "/api/payments/cancel",
      "destination": "/api/payments/cancel"
    },
    {
      "source": "/api/payments/refund",
      "destination": "/api/payments/refund"
    },
    {
      "source": "/api/payments/webhook",
      "destination": "/api/payments/webhook"
    },
    {
      "source": "/api/payments/transactions",
      "destination": "/api/payments/transactions"
    },
    {
      "source": "/api/search-by-image",
      "destination": "/api/search-by-image"
    },
    {
      "source": "/((?!api/|assets/|favicon.svg|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}
